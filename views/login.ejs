<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><title>Login</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"></head>
<body class="d-flex justify-content-center align-items-center" style="height:100vh;background:#f5f7fa">
  <form method="POST" action="/login" style="width:350px">
    <h3>Login</h3>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <input type="hidden" name="redirect" value="<%= redirect %>">
    <input name="email" type="email" class="form-control mb-2" placeholder="Email" required>
    <input name="password" type="password" class="form-control mb-2" placeholder="Password" required>
    <button class="btn btn-primary w-100">Login</button>
    <p class="mt-2">No account? <a href="/register">Register</a></p>
  </form>
</body>
</html>
