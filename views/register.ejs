<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><title>Register</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"></head>
<body class="d-flex justify-content-center align-items-center" style="height:100vh;background:#f5f7fa">
  <form method="POST" action="/register" style="width:350px">
    <h3>Register</h3>
    <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
    <input name="full_name" class="form-control mb-2" placeholder="Full Name" required>
    <input name="email" type="email" class="form-control mb-2" placeholder="Email" required>
    <input name="password" type="password" class="form-control mb-2" placeholder="Password" required>
    <button class="btn btn-success w-100">Register</button>
    <p class="mt-2">Have account? <a href="/login">Login</a></p>
  </form>
</body>
</html>
