<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><title>Account</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<style>body{background:#f5f7fa}.navbar{background:#0d6efd}.navbar-brand,.nav-link{color:#fff!important}</style></head>
<body>
<nav class="navbar navbar-expand-lg"><div class="container">
  <a class="navbar-brand" href="/">⚡ TechStore</a>
  <ul class="navbar-nav ms-auto"><li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li></ul>
</div></nav>
<div class="container my-4">
  <h2>Welcome, <%= user.full_name %></h2>
  <h4>Your Orders</h4>
  <% if (orders.length === 0) { %><p>No orders yet.</p><% } else { %>
    <table class="table">
      <thead><tr><th>Order #</th><th>Date</th><th>Total</th><th>Status</th></tr></thead>
      <tbody>
        <% orders.forEach(o => { %>
          <tr><td><%= o.id %></td><td><%= o.created_at %></td><td>€<%= o.total.toFixed(2) %></td><td><%= o.status %></td></tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
</body>
</html>
