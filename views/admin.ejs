<!DOCTYPE html>
<html><head><title>Admin</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"></head>
<body>
<div class="container my-4">
  <h2>Admin Panel</h2>
  <h4>Products</h4><a href="/admin/products/add" class="btn btn-success mb-3">Add Product</a>
  <table class="table"><thead><tr><th>ID</th><th>Name</th><th>Price</th><th>Actions</th></tr></thead>
    <tbody><% products.forEach(p => { %><tr><td><%= p.id %></td><td><%= p.name %></td><td>€<%= p.price.toFixed(2) %></td><td>
      <a href="/admin/products/edit/<%= p.id %>" class="btn btn-sm btn-warning">Edit</a>
      <form method="POST" action="/admin/products/delete/<%= p.id %>" style="display:inline"><button class="btn btn-sm btn-danger">Delete</button></form>
    </td></tr><% }) %></tbody></table>
  <h4>Recent Orders</h4>
  <table class="table"><thead><tr><th>ID</th><th>Customer</th><th>Total</th><th>Date</th></tr></thead>
    <tbody><% orders.forEach(o => { %><tr><td><%= o.id %></td><td><%= o.full_name %></td><td>€<%= o.total.toFixed(2) %></td><td><%= o.created_at %></td></tr><% }) %></tbody></table>
</div>
</body></html>
